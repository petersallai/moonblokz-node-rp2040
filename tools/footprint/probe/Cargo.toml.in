# Rendered by footprint.py: @WS@ is the workspace being measured.
[package]
name = "footprint-probe"
version = "0.1.0"
edition = "2024"

[dependencies]
cortex-m = { version = "0.7", features = ["inline-asm"] }
cortex-m-rt = "0.7"
embassy-rp = { version = "0.8", features = ["unstable-pac", "time-driver", "critical-section-impl", "rp2040"] }
# The scheme and the block-size tier reach every crate through the blockchain's
# forwarding (Story 6.17): one scheme feature below picks it for the whole graph.
moonblokz-blockchain = { path = "@WS@/moonblokz-blockchain", default-features = false, features = ["block-size-2016"] }
moonblokz-chain-types = { path = "@WS@/moonblokz-chain-types", default-features = false }
moonblokz-configuration = { path = "@WS@/moonblokz-configuration", default-features = false }
moonblokz-storage = { path = "@WS@/moonblokz-storage", default-features = false }
moonblokz-crypto = { path = "@WS@/moonblokz-crypto-lib", default-features = false }

[features]
default = ["schnorr"]
with-chain = []
schnorr = ["moonblokz-blockchain/schnorr"]
bls-min-sig = ["moonblokz-blockchain/bls-min-sig"]
bls-min-pk = ["moonblokz-blockchain/bls-min-pk"]

# The node's release profile.
[profile.release]
lto = true
opt-level = "z"
incremental = false
codegen-units = 1
debug = true
panic = "abort"
